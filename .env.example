# Copie este arquivo para ".env" e preencha antes de rodar o bot

# Numero do DONO do bot, no formato internacional SEM "+" e SEM espacos,
# seguido de "@c.us". Exemplo para +55 11 91234-5678:
# OWNER_NUMBER=5511912345678@c.us
OWNER_NUMBER=

# Prefixo dos comandos (o padrao do menu usa virgula)
PREFIX=,
